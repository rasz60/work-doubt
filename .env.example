# ── Backend ──────────────────────────────────────────────
PORT=8080
ALLOW_ORIGIN=http://localhost:8081

# ── DB: Supabase ─────────────────────────────────────────
# Supabase 대시보드 → 우측 상단 [Connect] → ORMs/Postgres 탭에서 복사한 뒤
# [YOUR-PASSWORD] 를 DB 비밀번호로 바꾸고, 끝에 ?sslmode=require 를 붙인다.
#
#  ⚠ Direct connection (db.<ref>.supabase.co:5432) 은 IPv6 전용이다.
#    IPv4 네트워크에서는 반드시 아래 Supavisor 풀러 호스트를 쓴다.
#
#  Session pooler  (포트 5432, 권장): prepared statement 사용 가능
#  Transaction 풀러(포트 6543)를 쓸 경우 DB_QUERY_MODE=exec 로 둔다.
#
#  사용자 이름은 postgres.<project-ref> 형식이다(점 포함).
DATABASE_URL=postgresql://postgres.hsykrtillmitbhkyzruq:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# 무료 플랜은 동시 연결 한도가 작다. 5~10 사이를 권장.
DB_MAX_CONNS=5
# 비워 두면 포트로 자동 판단(6543 → exec). 강제: cache_statement | exec | simple
DB_QUERY_MODE=

# 로컬 Docker Postgres 로 되돌릴 때(docker-compose.yml):
# DATABASE_URL=postgres://workout:workout@localhost:5432/workout?sslmode=disable

# 32바이트 이상. 예: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=720h

# ── AI 코치 ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ── 소셜 로그인 ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8081/auth/callback/google

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URL=http://localhost:8081/auth/callback/kakao

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URL=http://localhost:8081/auth/callback/naver

# ── Frontend (app/.env) ──────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
