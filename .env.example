# ── 운동기록 백엔드 (Go) ── 저장소 루트의 .env. 로컬: . .\scripts\load-env.ps1 / 서버: pm2 가 읽는다
# 프론트엔드(Expo) 값은 app/.env (app/.env.example)

# Caddy 뒤에서는 127.0.0.1 의 이 포트로 뜬다 (ae2p Caddyfile 의 /api/workout/* → 127.0.0.1:8091)
PORT=8091
# 로컬 개발(Expo 웹 서버)에서만 필요. 배포는 같은 도메인이라 CORS 가 필요 없다
ALLOW_ORIGIN=http://localhost:8081

# ── 로그인 (ae:p 포털 · Supabase Auth) ──
# 공용 Supabase 프로젝트 주소. 로그인 토큰의 공개키(JWKS)를 여기서 받는다
SUPABASE_URL=https://xxxxxxxx.supabase.co

# ── DB: 공용 Supabase 의 workout 스키마 ──
# Supabase 대시보드 → 우측 상단 [Connect] → Session pooler 문자열 ([YOUR-PASSWORD] 를 DB 비밀번호로)
#  ⚠ Direct connection (db.<ref>.supabase.co) 은 IPv6 전용이라 Oracle 서버(IPv4)에서는 풀러를 쓴다
#  Transaction 풀러(포트 6543)를 쓸 경우 DB_QUERY_MODE=exec
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# 무료 플랜은 동시 연결 한도가 작다 (업무일지·포털과 나눠 쓴다)
DB_MAX_CONNS=5
DB_QUERY_MODE=

# ── AI 코치 ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
