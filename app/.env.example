# Expo 앱 환경 변수 (EXPO_PUBLIC_* 는 빌드에 그대로 들어간다 — 비밀값 금지)

# ae:p 공용 Supabase 프로젝트 (포털·업무일지와 같은 값이어야 로그인이 공유된다)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Go 백엔드 주소. 웹 배포본은 비워 두면 같은 도메인의 /api/workout 을 쓴다.
# 로컬 개발: http://localhost:8080   네이티브 앱: https://ae2p.duckdns.org/api/workout
EXPO_PUBLIC_API_BASE_URL=
