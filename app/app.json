{
  "expo": {
    "name": "Workout",
    "slug": "workout",
    "scheme": "workout",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.devsixt.workout",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.devsixt.workout",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0e1218"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "운동기록",
      "themeColor": "#eef0f3"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Apple Watch · 건강 앱에 기록된 운동(종류 · 시간 · 거리 · 칼로리 · 심박)을 읽어 운동 기록에 자동으로 남깁니다.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/workout",
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
