{
  "expo": {
    "name": "Workout",
    "slug": "workout",
    "scheme": "workout",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devsixt.workout"
    },
    "android": {
      "package": "com.devsixt.workout",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "운동기록",
      "themeColor": "#eef0f3"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "baseUrl": "/workout",
      "typedRoutes": false
    }
  }
}
